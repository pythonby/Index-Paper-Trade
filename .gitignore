# NEVER commit real credentials -- this is what protects your Telegram token
# if this repo is public. GitHub Actions Secrets are used instead (they are
# encrypted and never appear in code or logs).
.env

# Local trade database and logs (these can contain your trading history --
# keep them out of a public repo; GitHub Actions uploads them as private
# artifacts instead, see the workflow file)
db/*.db
logs/*.log

# Python cache/build artifacts
__pycache__/
*.pyc
*.pyo
venv/
.venv/
*.egg-info/

# OS/editor cruft
.DS_Store
.vscode/
