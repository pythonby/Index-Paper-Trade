# Copy this file to ".env" and fill in your real values.
# NEVER commit the real .env file to version control.

# Get this from @BotFather on Telegram after creating a bot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Get this by messaging @userinfobot on Telegram, or from the getUpdates
# API response after messaging your bot once
TELEGRAM_CHAT_ID=your_chat_id_here
